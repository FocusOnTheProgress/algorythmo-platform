# CRM Playwright suite — environment variables
# Copy this file to spec/system/algorythmo/.env.test and fill in values.
# .env.test is gitignored (never commit credentials).

# Base URL of the running Algorythmo OS instance (docker stack)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Test account credentials (matches seed.rake dev seed)
PLAYWRIGHT_EMAIL=test@algorythmo.com
PLAYWRIGHT_PASSWORD=<fill-in-from-seed.rake>

# Account ID seeded by seed.rake (default: 1)
# PLAYWRIGHT_ACCOUNT_ID=1
